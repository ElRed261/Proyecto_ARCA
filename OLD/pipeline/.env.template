# Path to the Google service-account JSON used to authenticate against Drive API.
GOOGLE_CREDENTIALS_PATH=

# ID of the Drive folder containing the meteorological .xlsm files.
DRIVE_FOLDER_ID=

# Optional: local directory tree to ingest instead of Google Drive (Drive stand-in).
# Non-empty => pipeline reads spreadsheets from this path; empty => Drive mode.
SOURCE_DIR=

# SQLAlchemy connection string (psycopg2 driver). Default matches docker/docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://arca:arca@localhost:5432/arca

# How often the polling flow runs (schedule for the Prefect deployment).
RUN_INTERVAL_HOURS=6