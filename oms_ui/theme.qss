/* Tema de OMS — PLANTILLA de string.Template.
   Cada token (fondo, superficie, borde, texto, acento...) lo sustituye
   oms_ui/theme.py desde PALETTE, ver docs/DISENO_OMS.md §2. Aquí NO se escribe
   un color literal. Los acentos por módulo (naranja, teal) son deuda
   de la fase 1: desaparecen en la fase 2, cuando los setStyleSheet inline ya no
   compitan con esta hoja.
   Nota: un signo de peso literal en este archivo lo interpretaría la plantilla;
   por eso la documentación de arriba no lo usa.
   Flat + 1px borders + radius: la transparencia del oráculo web no porta a Qt. */

QWidget {
    background-color: $fondo;
    color: $texto;
    font-size: 13px;
}

QMainWindow, QDialog {
    background-color: $fondo;
}

QGroupBox {
    background-color: $superficie;
    border: 1px solid $borde;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 8px;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: $suave;
}

QLabel {
    background-color: transparent;
}

QLineEdit, QComboBox, QDateEdit, QSpinBox {
    background-color: $superficie;
    border: 1px solid $borde_input;
    border-radius: 6px;
    padding: 6px 8px;
}
/* text selection only where there is text being selected: on a QComboBox
   the property cascades into the popup list and painted its selection. */
QLineEdit, QDateEdit, QSpinBox {
    selection-background-color: $acento_suave;
}
QLineEdit:focus, QComboBox:focus, QDateEdit:focus {
    border: 1px solid $acento_foco;
}

/* QComboBox popup: the combo's own rule must not leak into the list, and
   the list must sit on the same light surface (no dark frame bands). */
QComboBox QAbstractItemView {
    background-color: $superficie;
    border: none;
    padding: 4px;
    selection-background-color: $borde;
    selection-color: $texto_alt;
}
QComboBox QAbstractItemView::item {
    padding: 4px 8px;
}
QLineEdit[readOnly="true"] {
    background-color: $panel;
    color: $acento_hover;
    font-weight: bold;
}
QLineEdit[error="true"] {
    border: 2px solid $error;
}

QPushButton {
    background-color: $superficie;
    border: 1px solid $borde_input;
    border-radius: 6px;
    padding: 7px 14px;
}
QPushButton:hover {
    border-color: $tenue;
    background-color: $panel_alt;
}
QPushButton:disabled {
    color: $tenue;
    background-color: $panel;
}
QPushButton[primary="true"] {
    background-color: $acento;
    border: 1px solid $acento;
    color: $superficie;
    font-weight: bold;
}
QPushButton[primary="true"]:hover {
    background-color: $acento_hover;
}
QPushButton[primary="true"]:disabled {
    background-color: $acento_deshabilitado;
    border-color: $acento_deshabilitado;
    color: $superficie;
}
QPushButton[danger="true"] {
    background-color: $error_fuerte;
    border: 1px solid $error_fuerte;
    color: $superficie;
}

QTableView {
    background-color: $superficie;
    alternate-background-color: $panel_alt;
    border: 1px solid $borde;
    border-radius: 8px;
    gridline-color: $borde;
}
QHeaderView::section {
    background-color: $panel;
    border: none;
    border-bottom: 1px solid $borde;
    padding: 6px;
    font-weight: bold;
    color: $suave;
}

QTabWidget::pane {
    background-color: $superficie;
    border: 1px solid $borde;
    border-radius: 8px;
}
QTabBar::tab {
    background-color: $panel;
    border: 1px solid $borde;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 6px 14px;
    color: $suave;
}
QTabBar::tab:selected {
    background-color: $superficie;
    color: $texto;
}

QListWidget {
    background-color: $superficie;
    border: 1px solid $borde;
    border-radius: 8px;
}
QListWidget::item {
    padding: 8px;
    border-radius: 6px;
}
QListWidget::item:selected {
    background-color: $acento_suave;
    color: $acento_texto;
}

QStatusBar {
    background-color: $superficie;
    border-top: 1px solid $borde;
    color: $suave;
}

QProgressBar {
    background-color: $borde;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: $acento_texto;
}
QProgressBar::chunk {
    background-color: $acento_foco;
    border-radius: 4px;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 10px;
}
QScrollBar::handle:vertical {
    background-color: $borde_input;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* ===== Neo Arca theme v2 (IMG vocabulary) ===== */
QPushButton[primary="true"] {
    background-color: $acento;
    border: none;
    border-radius: 8px;
    color: $superficie;
    font-weight: bold;
    padding: 10px 14px;
}
QPushButton[primary="true"]:hover {
    background-color: $acento_hover;
}
QPushButton[primary="true"]:disabled {
    background-color: $acento_deshabilitado;
    color: $superficie;
}
QPushButton[accent="orange"] {
    background-color: $naranja;
    border: 1px solid $naranja;
    color: $superficie;
    font-weight: bold;
    border-radius: 8px;
    padding: 9px 16px;
}
QPushButton[accent="orange"]:hover { background-color: $naranja_fuerte; }
QPushButton[accent="green"] {
    background-color: $ok;
    border: 1px solid $ok;
    color: $superficie;
    font-weight: bold;
    border-radius: 8px;
    padding: 9px 16px;
}
QPushButton[accent="green"]:hover { background-color: $ok_fuerte; }
QPushButton[circle="true"] {
    border: 1px solid $borde;
    border-radius: 22px;
    background-color: $superficie;
    color: $acento_foco;
    font-weight: bold;
}
QPushButton[link="true"] {
    border: none;
    background-color: transparent;
    padding: 2px;
    font-weight: bold;
}
QPushButton[link="blue"] { color: $acento; }
QPushButton[link="violet"] { color: $acento; }
QPushButton[link="orange"] { color: $naranja; }
QLabel[pill="role"] {
    background-color: $acento_fondo;
    color: $acento;
    border-radius: 10px;
    padding: 2px 12px;
    font-weight: 600;
}
QLabel[pill="ok"] {
    background-color: $ok_fondo;
    color: $ok_fuerte;
    border-radius: 10px;
    padding: 2px 12px;
    font-weight: 600;
}
QLabel[pill="info"] {
    background-color: $acento_suave;
    color: $acento_hover;
    border-radius: 10px;
    padding: 2px 12px;
    font-weight: 600;
}
QLabel[pill="warn"] {
    background-color: $ambar_fondo;
    color: $ambar;
    border-radius: 10px;
    padding: 2px 12px;
    font-weight: 600;
}
QFrame[tint="violet"] {
    background-color: $acento_suave;
    border: 1px solid $acento;
    border-radius: 12px;
}
QFrame[tint="orange"] {
    background-color: $naranja_fondo;
    border: 1px solid $naranja_debil;
    border-radius: 12px;
}
QFrame[tint="blue"] {
    background-color: $acento_fondo;
    border: 1px solid $acento;
    border-radius: 12px;
}
QFrame[tint="teal"] {
    background-color: $teal_fondo;
    border: 1px solid $teal_borde;
    border-radius: 12px;
}
QLabel[cardTitle="true"] {
    font-size: 18px;
    font-weight: 800;
    color: $texto_alt;
    background-color: transparent;
}
QLabel[cardSub="true"] {
    font-size: 13px;
    color: $suave_alt;
    background-color: transparent;
}
QLabel[emptyTitle="true"] {
    font-size: 16px;
    font-weight: 800;
    color: $texto_alt;
    background-color: transparent;
}
QLabel[emptyBody="true"] {
    font-size: 13px;
    color: $suave_alt;
    background-color: transparent;
}
QLabel[tile="blue"] {
    background-color: $acento_foco;
    color: $superficie;
    border-radius: 10px;
    font-size: 18px;
    font-weight: 800;
    padding: 10px;
}
QLabel[tile="violet"] {
    background-color: $acento;
    color: $superficie;
    border-radius: 10px;
    font-size: 18px;
    font-weight: 800;
    padding: 10px;
}
QLabel[tile="orange"] {
    background-color: $naranja_alt;
    color: $superficie;
    border-radius: 10px;
    font-size: 18px;
    font-weight: 800;
    padding: 10px;
}
QLabel[tile="teal"] {
    background-color: $teal;
    color: $superficie;
    border-radius: 10px;
    font-size: 18px;
    font-weight: 800;
    padding: 10px;
}
QLabel[tile="gray"] {
    background-color: $suave_alt;
    color: $superficie;
    border-radius: 10px;
    font-size: 18px;
    font-weight: 800;
    padding: 10px;
}
QPushButton[dark="true"] {
    background-color: $texto_alt;
    border: 1px solid $texto_alt;
    color: $superficie;
    font-weight: bold;
    border-radius: 8px;
    padding: 9px 16px;
}
QPushButton[dark="true"]:hover { background-color: $texto; }

/* ---------------------------------------------------------------- estados
   §4 de docs/DISENO_OMS.md. Un control deshabilitado NO puede verse igual que
   uno editable: era el defecto UI-02, por el que el observador no distinguía
   las celdas bloqueadas del Sinóptico. Solo propiedades que Qt entiende: nada
   de `opacity` ni `outline`, que Qt descarta en silencio. */

QLineEdit:disabled, QComboBox:disabled, QDateEdit:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled, QPlainTextEdit:disabled, QTextEdit:disabled {
    background-color: $panel;
    color: $tenue;
    border: 1px dashed $borde_input;
}

QPushButton:focus, QToolButton:focus, QCheckBox:focus, QRadioButton:focus,
QComboBox:focus, QToolTip:focus {
    border: 2px solid $acento_foco;
}

QCheckBox:disabled, QRadioButton:disabled, QLabel:disabled {
    color: $tenue;
}

/* --- Riel de navegación (docs/DISENO_OMS.md §4, S4) ------------------ */
#rail {
    background-color: $superficie;
    border-right: 1px solid $borde;
}

#railLogo {
    color: $texto_alt;
    font-size: 15px;
    font-weight: 800;
    background: transparent;
}

#railEmail {
    color: $suave_alt;
    font-size: 11px;
    background: transparent;
}

QPushButton[rail="nav"] {
    border: none;
    border-left: 3px solid transparent;
    text-align: left;
    padding: 10px 12px;
    font-weight: 600;
    color: $texto;
    background: transparent;
}

QPushButton[rail="nav"][active="true"] {
    background-color: $acento_suave;
    border-left-color: $acento;
    color: $acento_texto;
}

QPushButton[rail="nav"][collapsed="true"] {
    text-align: center;
    padding: 10px 0;
    font-weight: 800;
    font-size: 15px;
    color: $acento;
}

QPushButton[rail="nav"][collapsed="true"][active="true"] {
    background-color: $acento_suave;
    color: $acento_texto;
}
